{
  "name": "dsh-web-extras",
  "version": "0.1.0",
  "description": "DeepSeek Harness Web 增强插件：会话完成提醒（提示音 + 立绘弹窗，支持裁剪/翻转/本地持久化）与外观定制（背景图、透明度、输入区折叠）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "pack": "pnpm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "keywords": [
    "deepseek-harness",
    "cordis",
    "plugin",
    "web",
    "notification",
    "appearance"
  ],
  "license": "MIT"
}
